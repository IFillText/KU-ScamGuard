# LINE Messaging API Credentials
# ดูได้จาก LINE Developers Console (https://developers.line.biz/)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# Port สำหรับ Web Server (ค่าเริ่มต้น 5000)
PORT=5000

# โฟลเดอร์โมเดล (เลือกได้: models/wangchanberta, models/phayathaibert, models/xlm_roberta)
MODEL_DIR=models/wangchanberta
